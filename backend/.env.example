# Copy this file to .env and fill in your own values before running the server.

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# Long, random string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# How long an admin login stays valid for
JWT_EXPIRES_IN=12h

# Admin login - two ways to set this up:
#
# 1) Locally, or on a host with terminal access: leave ADMIN_PASSWORD blank
#    below and run `npm run set-admin-password` instead. That writes a
#    hashed password to src/data/admin.json and never puts the plain
#    password in a file.
#
# 2) On a free host with no terminal access (Render, etc.), set both
#    ADMIN_USERNAME and ADMIN_PASSWORD here. The server creates the account
#    from these automatically on startup if no account exists yet - which
#    also means that on hosts that wipe storage on redeploy, the account
#    re-creates itself every time using whatever is set here. If you change
#    your password from the Account tab on such a host, update ADMIN_PASSWORD
#    here too, or the next redeploy will revert it to this value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: only needed if you've attached a persistent disk (e.g. on
# Render's paid Starter plan + a Disk). Set this to the disk's mount path
# (Render's convention is "/data") and all content, the admin account, and
# uploaded files/APKs will be stored there instead of inside the backend
# folder - which means they survive restarts and redeploys. Leave blank for
# local development, or for any host where the filesystem already persists.
DATA_DIR=

# Needed for the web translator (/translate page) to actually work.
# Get a free key at https://aistudio.google.com/apikey - the same kind of
# key your Android app already uses.
GEMINI_API_KEY=
